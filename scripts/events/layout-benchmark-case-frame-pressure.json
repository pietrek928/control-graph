[
  { "type": "reload" },
  { "type": "focus", "selector": ".flow-wrap" },
  { "type": "loadSheet", "sheetFile": "scripts/fixtures/all-block-types-sheet.json", "waitMs": 180 },
  { "type": "click", "selector": "text=Layout dbg" },

  { "type": "assertNodeExists", "nodeId": "f-safety-all", "exists": true },
  { "type": "assertNodeExists", "nodeId": "n-not", "exists": true },
  { "type": "assertNodeExists", "nodeId": "n-and", "exists": true },

  { "type": "focus", "selector": ".flow-wrap" },
  { "type": "press", "key": "Control+a" },
  { "type": "wait", "ms": 110 },
  { "type": "rememberLayoutMetric", "key": "baseline" },
  { "type": "rememberBlockOverlapCount", "key": "baselineOverlap" },
  { "type": "state", "label": "frame-pressure:baseline" },

  { "type": "focus", "selector": ".flow-wrap" },
  { "type": "press", "key": "Control+j" },
  { "type": "wait", "ms": 220 },
  { "type": "rememberLayoutMetric", "key": "pass1" },
  { "type": "assertLayoutScoreNotWorse", "fromKey": "baseline", "maxIncrease": 130000 },
  { "type": "assertLayoutCrossingsNotWorse", "fromKey": "baseline", "maxIncrease": 0 },
  { "type": "assertBlockOverlapCountNotWorse", "fromKey": "baselineOverlap", "maxIncrease": 0 },

  { "type": "click", "selector": ".react-flow__pane" },
  { "type": "down", "selector": ".react-flow__node[data-id=\"n-not\"]", "button": "left" },
  { "type": "move", "x": 880, "y": 535, "steps": 22 },
  { "type": "up", "button": "left" },
  { "type": "down", "selector": ".react-flow__node[data-id=\"n-and\"]", "button": "left" },
  { "type": "move", "x": 900, "y": 555, "steps": 22 },
  { "type": "up", "button": "left" },
  { "type": "down", "selector": ".react-flow__node[data-id=\"n-ton\"]", "button": "left" },
  { "type": "move", "x": 920, "y": 565, "steps": 22 },
  { "type": "up", "button": "left" },
  { "type": "down", "selector": ".react-flow__node[data-id=\"n-or\"]", "button": "left" },
  { "type": "move", "x": 945, "y": 560, "steps": 22 },
  { "type": "up", "button": "left" },

  { "type": "focus", "selector": ".flow-wrap" },
  { "type": "press", "key": "Control+a" },
  { "type": "wait", "ms": 110 },
  { "type": "rememberLayoutMetric", "key": "perturbed" },
  { "type": "rememberBlockOverlapCount", "key": "perturbedOverlap" },
  { "type": "state", "label": "frame-pressure:perturbed" },

  { "type": "focus", "selector": ".flow-wrap" },
  { "type": "press", "key": "Control+j" },
  { "type": "wait", "ms": 280 },
  { "type": "rememberLayoutMetric", "key": "recovered" },
  { "type": "assertLayoutScoreNotWorse", "fromKey": "perturbed", "maxIncrease": 0 },
  { "type": "assertLayoutCrossingsNotWorse", "fromKey": "perturbed", "maxIncrease": 0 },
  { "type": "assertBlockOverlapCountNotWorse", "fromKey": "perturbedOverlap", "maxIncrease": 0 },
  { "type": "state", "label": "frame-pressure:final" }
]
